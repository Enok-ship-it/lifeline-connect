# Copy this file to ".env" and fill in your own values. Never commit the real .env file.

# Get this from MongoDB Atlas: Database > Connect > Drivers > copy connection string
MONGO_URI=mongodb+srv://yadavsumir63_db_user:3fnAxFEHbFKaaTcD@cluster0.bfgnfvu.mongodb.net/lifelineconnect

# Any long random string - used to sign login tokens. Change this to your own secret.
JWT_SECRET=pW3drLQsTOwD1uwKgQqwlkWnzTb21gZUGaXjmZndp7Xly4eatvAwqHisuRzyWYMe

# Port the backend server runs on
PORT=5000
CLIENT_ORIGIN=http://localhost:5000

# MongoDB pool tuning for production deployments
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000

# ---- Optional: email notifications ----
# If you leave these blank, the app still works perfectly - emails are
# just printed to the terminal instead of actually sent. Fill these in
# once you're ready for real notifications.
#
# Easiest option: a Gmail account with an "App Password" (not your normal
# Gmail password - generate one at https://myaccount.google.com/apppasswords,
# requires 2-Step Verification to be turned on first).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=LifeLine Connect <your-email@example.com>
